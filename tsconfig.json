{
  // Type-checks the evidence core (plain JavaScript with JSDoc types). No build output.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "skipLibCheck": true
  },
  "files": ["js/core.js"]
}
